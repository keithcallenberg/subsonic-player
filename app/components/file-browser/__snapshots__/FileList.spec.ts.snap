    <div class="trackCell"><a draggable="false">
        <div class="centerAll preloadImage trackImage"><span class="skeletonLoader"><span class="visuallyHidden">Loading image</span></span><img alt="track-0" class="image" draggable="false" src="image-0"></div>
        <div class="marqueeScroll mBXS" inert="">
