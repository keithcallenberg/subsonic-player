// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`FileList > matches the snapshot 1`] = `
"<div class="trackTable">
  <!--v-if-->
  <div class="trackRow">
    <div class="trackCell">
      <div>
        <div class="centerAll preloadImage trackImage">
          <div class="iconImage">
            <iconinfocircle fill="none" strokewidth="1" class="icon"></iconinfocircle>
          </div>
        </div>
        <p>No folders/files found.</p>
      </div>
    </div>
  </div>
</div>
<!--v-if-->"
`;

exports[`FileList > when route params does have an Id > matches the snapshot 1`] = `
